# ==============================================================================
# GEPIS OpenData - Configurações de Ambiente para Desenvolvimento
# ==============================================================================
# Copie este arquivo para '.env' na raiz do projeto para carregar as credenciais
# e configurações do GitHub automaticamente no backend Tauri:
#
#   cp .env.example .env
#
# ------------------------------------------------------------------------------
# GitHub Collaboration Configuration
# ------------------------------------------------------------------------------

# Seu nome de usuário no GitHub
GITHUB_USERNAME=seu-usuario-github

# Token de Acesso Pessoal (Personal Access Token - Classic ou Fine-grained)
# Permissões necessárias: 'repo' (ou 'contents:write' e 'pull-requests:write')
GITHUB_TOKEN=ghp_seuTokenPessoalAqui

# Organização ou Usuário dono do repositório destino
GITHUB_OWNER=grupo-de-pesquisa-gepis

# Nome do repositório destino
GITHUB_REPO=gepisopendata

# Branch base padrão para envio de Pull Requests (padrão: production)
GITHUB_PR_TARGET_BRANCH=production
