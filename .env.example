# ==============================================================================
# GEPIS OpenData - Configurações de Ambiente para Desenvolvimento
# ==============================================================================
# Para habilitar o preenchimento automático das configurações de colaboração no
# desktop Tauri durante o desenvolvimento, copie este modelo para '.env':
#
#   cp .env.example .env
#
# ------------------------------------------------------------------------------
# GitHub Collaboration Configuration
# ------------------------------------------------------------------------------

# Seu nome de usuário no GitHub (ex: wagner)
GITHUB_USERNAME=seu-usuario-github

# ==============================================================================
# PERMISSÕES OBRIGATÓRIAS DO PERSONAL ACCESS TOKEN (PAT - Classic)
# ==============================================================================
# Ao gerar seu token em: https://github.com/settings/tokens/new
# Certifique-se de marcar EXATAMENTE os seguintes escopos (scopes):
#
#   [X] repo                 (Full control of private repositories)
#       [X] repo:status      (Access commit status)
#       [X] repo_deployment  (Access deployment status)
#       [X] public_repo      (Access public repositories)
#       [X] repo:invite      (Access repository invitations)
#       [X] security_events  (Read and write security events)
#
#   [X] workflow             (Update GitHub Action workflows)
#
#   [X] write:packages       (Upload packages to GitHub Package Registry)
#       [X] read:packages    (Download packages from GitHub Package Registry)
#
#   [X] admin:repo_hook      (Full control of repository hooks)
#       [X] write:repo_hook  (Write repository hooks)
#       [X] read:repo_hook   (Read repository hooks)
#
#   [X] gist                 (Create gists)
#
#   [X] notifications        (Access notifications)
# ==============================================================================
GITHUB_TOKEN=ghp_seuTokenPessoalAqui

# Organização ou Usuário dono do repositório destino
GITHUB_OWNER=grupo-de-pesquisa-gepis

# Nome do repositório destino
GITHUB_REPO=gepisopendata

# Branch base padrão para envio de Pull Requests (padrão: production)
GITHUB_PR_TARGET_BRANCH=production
